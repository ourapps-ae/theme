{
  "id": "theme",
  "type": "ae/theme",
  "version": "1.0.0",
  "description": "Design tokens for colours, spacing, radii, type scale and an animated background, rendered to CSS variables, Swift constants and Kotlin constants.",
  "operations": {
    "validateTokens": {
      "arguments": [
        "tokens:Tokens"
      ],
      "returns": "string[]"
    },
    "resolveTheme": {
      "arguments": [
        "file:ThemeFile",
        "settings:{themeName?:string,primaryColour?:string,tableColour?:string}"
      ],
      "returns": "Tokens"
    },
    "themeNames": {
      "arguments": [
        "file:ThemeFile"
      ],
      "returns": "string[]"
    },
    "colourTable": {
      "arguments": [
        "tokens:Tokens"
      ],
      "returns": "Record<ColourName,string> (every colour name to #rrggbb, opacity dropped); web-host passes it as the colours map for themeColour and backgroundColour"
    },
    "accentColour": {
      "arguments": [
        "tokens:Tokens"
      ],
      "returns": "string (#rrggbb of the primary colour); apple-host tint"
    },
    "shellPalette": {
      "arguments": [
        "tokens:Tokens"
      ],
      "returns": "{primary,secondary,background,surface,onPrimary} as 0xAARRGGBB numbers (secondary is the table colour); android-host ShellPalette"
    },
    "cssVariables": {
      "arguments": [
        "tokens:Tokens"
      ],
      "returns": "map<string,string>"
    },
    "renderCss": {
      "arguments": [
        "file:ThemeFile"
      ],
      "returns": "string"
    },
    "renderSwift": {
      "arguments": [
        "file:ThemeFile"
      ],
      "returns": "string"
    },
    "renderKotlin": {
      "arguments": [
        "file:ThemeFile"
      ],
      "returns": "string"
    },
    "applyTheme": {
      "arguments": [
        "tokens:Tokens",
        "element:{style:{setProperty(name:string,value:string):void}}"
      ],
      "returns": "void"
    },
    "parseColourSetting": {
      "arguments": [
        "value:string"
      ],
      "returns": "string (#rrggbb or #rrggbbaa; accepts 'hex rrggbb', '#rrggbb', 'rrggbb'; throws otherwise)"
    },
    "parseColour": {
      "arguments": [
        "hex:string"
      ],
      "returns": "{r:number,g:number,b:number,a:number}"
    },
    "glyphFrame": {
      "arguments": [
        "particle:Particle",
        "style:BackgroundStyle",
        "t:number",
        "light:number",
        "width:number",
        "height:number",
        "sizeBase?:number"
      ],
      "returns": "{x:number,y:number,size:number,alpha:number,rotation:number,sprite:number}|null"
    },
    "speckFrame": {
      "arguments": [
        "speck:Speck",
        "style:BackgroundStyle",
        "t:number",
        "width:number",
        "height:number"
      ],
      "returns": "{x:number,y:number,radius:number,alpha:number}"
    },
    "flicker": {
      "arguments": [
        "style:BackgroundStyle",
        "t:number"
      ],
      "returns": "number"
    },
    "figureBox": {
      "arguments": [
        "front:Front",
        "imageWidth:number",
        "imageHeight:number",
        "width:number",
        "height:number"
      ],
      "returns": "{x:number,y:number,w:number,h:number}"
    },
    "Background": {
      "arguments": [
        "canvas:HTMLCanvasElement",
        "theme:Tokens"
      ],
      "returns": "{setTheme(theme:Tokens):void,setScene(scene:Scene):void,stop():void,figures:boolean}"
    }
  },
  "native": {
    "apple": [
      "ThemeTokens.all",
      "ThemeSet.named(_:)",
      "ThemeSet.resolved(primary:table:)",
      "ThemeColour.setting(_:)",
      "BackgroundMath.glyphFrame",
      "BackgroundMath.speckFrame",
      "ThemeBackgroundView",
      "ThemeSet.accent"
    ],
    "android": [
      "ThemeTokens.ALL",
      "ThemeSet.named",
      "ThemeSet.resolved",
      "parseColourSetting",
      "BackgroundMath.glyphFrame",
      "BackgroundMath.speckFrame",
      "ThemeBackground",
      "ThemeSet.palette() returning ThemePalette(primary,secondary,background,surface,onPrimary: Long)"
    ]
  },
  "schema": "implementation/web/tokens.schema.json",
  "hosts": {
    "web-host": "colourTable",
    "apple-host": "accentColour (web) or ThemeSet.accent (Swift)",
    "android-host": "shellPalette (web) or ThemeSet.palette() (Kotlin)"
  }
}
